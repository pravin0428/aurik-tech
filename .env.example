# ---------------------------------------------------------------------------
# Example environment configuration. Copy to ".env" and adjust locally.
# NEVER commit a real ".env" file. Values here are local-development placeholders.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
SERVICE_NAME=aurik-tech
HOST=0.0.0.0
PORT=3000

# Structured logging
# levels: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# pretty-print logs for humans (dev only; ignored in production/test)
LOG_PRETTY=true

# PostgreSQL
DATABASE_URL=postgres://aurik:aurik@localhost:5432/aurik
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_SSL=false

# HTTP request handling
REQUEST_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# Worker / job queue
# WORKER_ID: unique worker identity; auto-generated from host+pid if unset.
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_RECOVERY_BATCH_SIZE=10
# Default max_attempts applied to newly enqueued jobs.
WORKER_MAX_ATTEMPTS=5
# A claimed job is considered abandoned (worker crashed) after this long.
WORKER_LEASE_MS=60000
# Exponential backoff between retries: base * 2^(attempt-1), capped at max.
WORKER_BACKOFF_BASE_MS=1000
WORKER_BACKOFF_MAX_MS=60000

# ---------------------------------------------------------------------------
# Vendor ingestion authentication
# Recommended: set to true in production.
# When true, INGESTION_API_KEYS must be non-empty or the service fails fast.
# ---------------------------------------------------------------------------
INGESTION_AUTH_REQUIRED=false
# Comma-separated "vendor:key" entries. NEVER commit real keys.
# Example (placeholders only): INGESTION_API_KEYS=acme:replace-me,globex:replace-me
INGESTION_API_KEYS=

# ---------------------------------------------------------------------------
# Normalization (Phase 5)
# ---------------------------------------------------------------------------
# Age after which a machine's latest evidence is considered stale. Assumption,
# not supplied by Aurik. Range: 60000 .. 2592000000 (1 minute .. 30 days).
NORMALIZATION_STALE_WINDOW_MS=86400000
# Directory holding the assessment reference/seed CSVs (used by `npm run seed`).
ASSETS_DIR=Aurik_Tech_Lead_Assessment_Assets/Aurik_Tech_Lead_Assessment_Assets
